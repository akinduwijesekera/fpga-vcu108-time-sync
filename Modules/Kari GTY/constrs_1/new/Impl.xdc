set_property RXCDR_CFG3 16'h0040 [get_cells -hierarchical -filter {NAME =~ *gen_gtye3_channel_inst[0].GTYE3_CHANNEL_PRIM_INST}]
set_property RXCDR_CFG3 16'h0040 [get_cells -hierarchical -filter {NAME =~ *gen_gtye3_channel_inst[1].GTYE3_CHANNEL_PRIM_INST}]
