##
## Clock domain crossings
##

# CH0 GTY transceiver crossings
# System clock (30 MHz or 33.333 ns) <-> CH0 RXOUTCLK (250 MHz or 4.0 ns)
set_false_path -from [get_clocks -of_objects [get_pins {i_PhaseCacheGtyWrapper/i_GtyQuad/GtyWrapper_inst/gtwizard_ultrascale_0_inst/inst/gen_gtwizard_gtye3_top.gtwizard_ultrascale_0_gtwizard_gtye3_inst/gen_gtwizard_gtye3.gen_channel_container[2].gen_enabled_channel.gtye3_channel_wrapper_inst/channel_inst/gtye3_channel_gen.gen_gtye3_channel_inst[0].GTYE3_CHANNEL_PRIM_INST/TXOUTCLK}]] -to [get_clocks -of_objects [get_pins {i_sysclk_mmcm/inst/mmcme3_adv_inst/CLKOUT0}]]
