##
## CDR Receiver RAW phase value config
##
set_property DMONITOR_CFG1 8'h01 [get_cells -hierarchical -filter {NAME =~ *gen_gtye3_channel_inst[0].GTYE3_CHANNEL_PRIM_INST}]
set_property ADAPT_CFG1 16'h801E [get_cells -hierarchical -filter {NAME =~ *gen_gtye3_channel_inst[0].GTYE3_CHANNEL_PRIM_INST}]
